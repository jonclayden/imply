#ifndef _IMPLY_CONFIG_H_
#define _IMPLY_CONFIG_H_

// Generated by configure when imply was installed -- do not edit
//
// Records what imply's own build found for parallel backend support on this
// machine, so a client package's use of Parallel.h doesn't need to re-run the
// same platform detection in its own configure script: LinkingTo: imply is
// enough to see the same answer imply itself found. This doesn't remove the
// need for a client's own OpenMP detection, since R already provides that
// centrally via SHLIB_OPENMP_CXXFLAGS; libdispatch has no such R-provided
// shortcut
//
// A client can still force this on with its own HAVE_LIBDISPATCH define (say,
// if it has reason to believe this finding doesn't apply -- a cross-compile,
// for instance); Parallel.h's own check is additive over this file, never
// subtractive, so there's no equivalent way to force it off from outside
@IMPLY_HAVE_LIBDISPATCH_DEFINE@

#endif
